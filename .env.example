# Copy to .env and fill in. .env is gitignored — safe to keep your key there.
# Cogito (Decart) dashboard: https://cogito.decart.ai — API keys
COGITO_API_KEY=cog-live-xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional: override the port instead of relying on the panel's SERVER_PORT
# PORT=3000

# ---- HTTPS (tls-cert.sh) ------------------------------------------------
# DuckDNS token: duckdns.org -> your domain -> "token" (NOT your password).
# tls-cert.sh reads this file itself, so the value never appears in shell
# history. Used for the DNS-01 challenge when requesting/renewing the
# Let's Encrypt certificate.
DUCKTNS_TOKEN=

# Domain the certificate is issued for. Defaults to minisearch.duckdns.org.
DUCKTNS_DOMAIN=minisearch.duckdns.org

# Contact address acme.sh registers with the CA.
ACME_EMAIL=you@example.com

# Extra hostnames to include, space separated.
# ALT_DOMAINS=example.com www.example.com

# Where the certificate files live. Defaults to the workspace root, which is
# what the server looks in. Uncomment only if you keep them elsewhere.
# TLS_CERT_FILE=/etc/letsencrypt/fullchain.pem
# TLS_KEY_FILE=/etc/letsencrypt/privkey.pem

# Run after a successful renewal. acme.sh rewrites the certificate files, but a
# running server keeps the old certificate in memory, so it needs a nudge.
# Example for Pterodactyl is awkward (the panel owns the process), so the usual
# answer is to restart the panel; set this if you have your own supervisor.
# TLS_RELOAD_CMD=systemctl reload minisearch