# ============================================================================
#  TEMPLATE FOR .env   —   paste your values after the "=" signs.
#
#  Copy this file to ".env" and fill in what you have. Blank is always fine:
#  every one of these is optional and the engine has a sensible default.
#  .env is gitignored, so keys in it are never committed.
# ============================================================================


# --- 1. AI agent ----------------------------------------------------------
#  Optional. Without it the assistant still answers, from raw index results.
#  Keys: https://cogito.decart.ai
COGITO_API_KEY=


# --- 2. Semantic search ---------------------------------------------------
#  Optional. Without it, search is pure keyword ranking (BM25), which works.
#  Keys: https://build.nvidia.com   (free credits, rate limited per key)
#
#  The endpoint and model are already configured in src/config.ts, so this is
#  the only value you need.
EMBEDDING_API_KEY=


# --- 3. HTTPS certificate -------------------------------------------------
#  Optional. Without a certificate the server serves plain HTTP.
#  The token is at duckdns.org -> your domain -> "token". It is NOT your
#  password. tls-cert.sh reads this file itself, so it never lands in your
#  shell history.
DUCKTNS_TOKEN=
ACME_EMAIL=


# ============================================================================
#  Below here everything is optional and already has a default.
#  Uncomment a line only if you want to change it.
# ============================================================================

# The panel sets SERVER_PORT; set this to use a fixed port instead.
# PORT=3000

# Certificate domain. Defaults to the panel's domain.
# DUCKTNS_DOMAIN=minisearch.duckdns.org

# Extra hostnames to include on the certificate, space separated.
# ALT_DOMAINS=example.com www.example.com

# Where the certificate files live. Defaults to the workspace root, which is
# what the server looks in. Uncomment only if you keep them elsewhere.
# TLS_CERT_FILE=/etc/letsencrypt/fullchain.pem
# TLS_KEY_FILE=/etc/letsencrypt/privkey.pem

# Run after a successful renewal. acme.sh rewrites the certificate files, but a
# running server keeps the old certificate in memory, so it needs a nudge.
# Pterodactyl owns the process, so the usual answer is to restart the panel;
# set this if you run it under your own supervisor.
# TLS_RELOAD_CMD=systemctl reload minisearch

# Point the semantic layer at a different service (for testing only).
# EMBEDDING_BASE_URL=
# EMBEDDING_MODEL=